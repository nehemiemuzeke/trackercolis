{
  "expo": {
    "name": "Colis RDC",
    "slug": "colis-rdc",
    "version": "1.0.0",
    "scheme": "colisrdc",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cd.collisrdc.appclient",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "L'application utilise votre position pour afficher la carte de suivi de vos colis.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "cd.collisrdc.appclient",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e40af"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'application utilise votre position pour afficher la carte de suivi de vos colis."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1e40af"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
